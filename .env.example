# Copy the names you need into your shell environment; do not commit real values.
OPT_ARENA_API_KEY=replace-with-your-key
OPT_ARENA_BASE_URL=https://your-openai-compatible-endpoint.example/v1
OPT_ARENA_MODEL=gpt-4o-mini
OPTMATH_DATA_DIR=/path/to/private/optmath-data
# Optional: directory holding a compatible generate_problem_manual_mode.py.
EVO_OPT_ARENA_DIR=/path/to/alternate/resources
OPTMATH_EVALUATION_STATS_FILE=/path/to/private/problem_type_analysis.json
OPTMATH_PT_STATS_FILE=/path/to/private/problem_types_atomic_info_statistics.json
